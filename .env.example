# Hermes API server (must remain bound to loopback)
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-a-dedicated-random-key
HERMES_MODEL=hermes-agent
HERMES_REQUEST_TIMEOUT_SECONDS=30
HERMES_RUN_POLL_INTERVAL_SECONDS=1
HERMES_RUN_MAX_WAIT_SECONDS=7200
HERMES_PROGRESS_INTERVAL_SECONDS=15
HERMES_EVENT_STREAM_CONNECT_TIMEOUT_SECONDS=30

# MCP bridge (loopback; Cloudflare Tunnel connects from the same host)
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp
LOG_LEVEL=INFO

# Bridge process identity/state (used by compose and healthcheck)
HERMES_RUN_DEFAULT_WAIT_SECONDS=45
BRIDGE_UID=1000
BRIDGE_GID=1000
BRIDGE_STATE_DIR=./data
BRIDGE_STATE_DB_PATH=/var/lib/hermes-mcp-bridge/state.sqlite3

# Observability (Block 2) — see docs/observability.md
# Structured logging: json (safe default) or text for local debugging.
BRIDGE_LOG_FORMAT=json
BRIDGE_LOG_LEVEL=INFO
# Extra field names to always redact, comma-separated (optional).
# BRIDGE_LOG_REDACT_FIELDS=
# Log hygiene (Block 6C): third-party libraries (httpx, uvicorn, mcp, ...) are
# re-emitted through the same redacting JSON formatter so every line on the
# stream parses as JSON, and bridge records are never written twice.
# BRIDGE_LOG_CAPTURE_THIRD_PARTY=1
# Level applied to third-party loggers that did not set one themselves.
# BRIDGE_LOG_THIRD_PARTY_LEVEL=WARNING

# Prometheus exporter: disabled by default, loopback only when enabled.
# BRIDGE_METRICS_ENABLED=1
# 127.0.0.1 = loopback. 172.17.0.1 / host.docker.internal are classified as
# "docker-gateway" and still require ALLOW_REMOTE=1 plus a token.
# BRIDGE_METRICS_HOST=127.0.0.1
# BRIDGE_METRICS_PORT=9464
# Remote exposure requires BOTH of the following and a TLS/authz front door.
# Never set these just to make scraping easier.
# BRIDGE_METRICS_ALLOW_REMOTE=1
# BRIDGE_METRICS_TOKEN=replace-with-a-dedicated-random-token

# Optional tracing: no-op unless enabled; export stays off by default.
# BRIDGE_TRACING_ENABLED=1
# BRIDGE_TRACING_EXPORT=1

# --------------------------------------------------------------------------
# Selective upstream retry (1.0.0) — see docs/retry-1.0.0.md
# --------------------------------------------------------------------------
# Disabled by default. When enabled, only explicitly classified GET operations
# may retry: health, run status and session message history. Session creation,
# run submission, stop and SSE are never retried by this policy.
BRIDGE_RETRY_ENABLED=false
BRIDGE_RETRY_MAX_ATTEMPTS=3
BRIDGE_RETRY_BASE_SECONDS=0.5
BRIDGE_RETRY_MAX_SECONDS=10.0
BRIDGE_RETRY_JITTER_RATIO=0.1

# --------------------------------------------------------------------------
# Selective upstream circuit breaker (1.0.0)
# See docs/circuit-breaker-1.0.0.md
# --------------------------------------------------------------------------
# Disabled by default. When enabled, one process-local breaker protects each
# safe GET class (health, run status and session history). The breaker is
# evaluated once per logical operation, outside the retry loop. Mutations, SSE
# and unknown endpoints are never circuit-protected.
BRIDGE_CIRCUIT_ENABLED=false
BRIDGE_CIRCUIT_FAILURE_THRESHOLD=5
BRIDGE_CIRCUIT_RECOVERY_SECONDS=30.0
BRIDGE_CIRCUIT_HALF_OPEN_MAX_CALLS=1
BRIDGE_CIRCUIT_SUCCESS_THRESHOLD=1

# --------------------------------------------------------------------------
# Security posture and HMAC lifecycle
# See docs/governance.md, docs/secret-rotation.md and
# docs/hmac-lifecycle-1.0.0.md
# --------------------------------------------------------------------------
# production | security_required  -> policy + HMAC key are mandatory (fail-closed)
# development | dev | test        -> unsigned manifests allowed, reported explicitly
BRIDGE_SECURITY_MODE=production

# Policy source precedence: BRIDGE_POLICY_JSON (inline) > BRIDGE_POLICY_PATH
# (file) > built-in safe policy. An invalid document or a configured-but-missing
# file is fail-closed: readiness reports not_ready.
BRIDGE_POLICY_PATH=config/policies/production.json
# BRIDGE_POLICY_JSON={"name":"inline","read_only_actions":["hermes_health"],"mutating_actions":[],"unknown_action_decision":"DENY"}

# Minimum accepted secret length (characters). Lower only in disposable labs.
BRIDGE_MIN_SECRET_LENGTH=32

# Secrets: <NAME>_FILE takes precedence over <NAME>. Point the *_FILE variables
# at mounted Docker secrets in production; never put key material in this file.
# HERMES_API_KEY_FILE=/run/secrets/hermes_api_key
# HERMES_BRIDGE_HMAC_SECRET_FILE=/run/secrets/hermes_bridge_hmac_secret
# HERMES_BRIDGE_HMAC_SECRET_PREVIOUS_FILE=/run/secrets/hermes_bridge_hmac_secret_previous
# HERMES_BRIDGE_HMAC_SECRET=replace-with-a-dedicated-random-secret-32-chars-min

# Non-secret key identifiers surfaced in health/readiness for rotation tracking.
# An active previous key in strict modes also requires an explicit ISO-8601
# interval with timezone. The end is exclusive and the interval cannot exceed
# seven days.
# HERMES_BRIDGE_HMAC_KEY_ID=2026-08-key1
# HERMES_BRIDGE_HMAC_PREVIOUS_KEY_ID=2026-07-key0
# HERMES_BRIDGE_HMAC_PREVIOUS_VALID_FROM=2026-08-06T12:00:00Z
# HERMES_BRIDGE_HMAC_PREVIOUS_VALID_UNTIL=2026-08-08T12:00:00Z
