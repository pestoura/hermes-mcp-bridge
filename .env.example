# Hermes API server (must remain bound to loopback)
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-a-dedicated-random-key
HERMES_MODEL=hermes-agent
HERMES_REQUEST_TIMEOUT_SECONDS=30
HERMES_RUN_POLL_INTERVAL_SECONDS=1
HERMES_RUN_MAX_WAIT_SECONDS=900

# MCP bridge (loopback; Cloudflare Tunnel connects from the same host)
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp
LOG_LEVEL=INFO
