# Hermes API server (must remain bound to loopback)
HERMES_API_BASE_URL=http://127.0.0.1:8642
HERMES_API_KEY=replace-with-a-dedicated-random-key
HERMES_MODEL=hermes-agent
HERMES_REQUEST_TIMEOUT_SECONDS=30
HERMES_RUN_POLL_INTERVAL_SECONDS=1
HERMES_RUN_MAX_WAIT_SECONDS=7200
HERMES_PROGRESS_INTERVAL_SECONDS=15
HERMES_EVENT_STREAM_CONNECT_TIMEOUT_SECONDS=30

# MCP bridge (loopback; Cloudflare Tunnel connects from the same host)
MCP_HOST=127.0.0.1
MCP_PORT=8765
MCP_PATH=/mcp
LOG_LEVEL=INFO

# Bridge process identity/state (used by compose and healthcheck)
HERMES_RUN_DEFAULT_WAIT_SECONDS=45
BRIDGE_UID=1000
BRIDGE_GID=1000
BRIDGE_STATE_DIR=./data
BRIDGE_STATE_DB_PATH=/var/lib/hermes-mcp-bridge/state.sqlite3

# Observability (Block 2) — see docs/observability.md
# Structured logging: json (safe default) or text for local debugging.
BRIDGE_LOG_FORMAT=json
BRIDGE_LOG_LEVEL=INFO
# Extra field names to always redact, comma-separated (optional).
# BRIDGE_LOG_REDACT_FIELDS=

# Prometheus exporter: disabled by default, loopback only when enabled.
# BRIDGE_METRICS_ENABLED=1
# BRIDGE_METRICS_HOST=127.0.0.1
# BRIDGE_METRICS_PORT=9464
# Remote exposure requires BOTH of the following and a TLS/authz front door.
# Never set these just to make scraping easier.
# BRIDGE_METRICS_ALLOW_REMOTE=1
# BRIDGE_METRICS_TOKEN=replace-with-a-dedicated-random-token

# Optional tracing: no-op unless enabled; export stays off by default.
# BRIDGE_TRACING_ENABLED=1
# BRIDGE_TRACING_EXPORT=1
